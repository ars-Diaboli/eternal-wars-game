<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Every game a test plays checks that each refused command left it as it was (GameSession.CheckRefusals, ADR-239). -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="EternalWars.CheckRefusals" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\EternalWars.Core.Events\EternalWars.Core.Events.csproj" />
    <ProjectReference Include="..\..\src\Core\EternalWars.Core.Domain\EternalWars.Core.Domain.csproj" />
    <ProjectReference Include="..\..\src\Core\EternalWars.Core.Data\EternalWars.Core.Data.csproj" />
    <ProjectReference Include="..\..\src\Core\EternalWars.Core.Generation\EternalWars.Core.Generation.csproj" />
    <ProjectReference Include="..\..\src\Core\EternalWars.Core.Network\EternalWars.Core.Network.csproj" />
    <ProjectReference Include="..\..\tools\EternalWars.Tools.Sim\EternalWars.Tools.Sim.csproj" />
  </ItemGroup>

</Project>
