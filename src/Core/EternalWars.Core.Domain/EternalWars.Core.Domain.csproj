<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Game model and rules: adventure map, heroes, economy, turns. No engine dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EternalWars.Core.Events\EternalWars.Core.Events.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EternalWars.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped creature and hero rosters (ADR-044, ADR-048); the Godot apps also read these files at run time. -->
    <EmbeddedResource Include="..\..\Godot\EternalWars.Godot.Assets\data\creatures.csv" Link="Creatures\creatures.csv" LogicalName="EternalWars.Creatures.csv" />
    <EmbeddedResource Include="..\..\Godot\EternalWars.Godot.Assets\data\heroes.csv" Link="Heroes\heroes.csv" LogicalName="EternalWars.Heroes.csv" />
    <EmbeddedResource Include="..\..\Godot\EternalWars.Godot.Assets\data\buildings.csv" Link="Towns\buildings.csv" LogicalName="EternalWars.Buildings.csv" />
    <EmbeddedResource Include="..\..\Godot\EternalWars.Godot.Assets\data\artifacts.csv" Link="Artifacts\artifacts.csv" LogicalName="EternalWars.Artifacts.csv" />
    <EmbeddedResource Include="..\..\Godot\EternalWars.Godot.Assets\data\artifact_sets.csv" Link="Artifacts\artifact_sets.csv" LogicalName="EternalWars.ArtifactSets.csv" />
  </ItemGroup>

</Project>
