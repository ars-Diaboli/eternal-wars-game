<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Game model and rules: adventure map, heroes, economy, turns. No engine dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EternalWars.Core.Events\EternalWars.Core.Events.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EternalWars.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped data tables (ADR-044, ADR-048, ADR-050, ADR-061) live in src/Core/data (ADR-071, DATA-1); the apps read this embedded copy. -->
    <EmbeddedResource Include="..\data\creatures.csv" Link="Creatures\creatures.csv" LogicalName="EternalWars.Creatures.csv" />
    <EmbeddedResource Include="..\data\heroes.csv" Link="Heroes\heroes.csv" LogicalName="EternalWars.Heroes.csv" />
    <EmbeddedResource Include="..\data\buildings.csv" Link="Towns\buildings.csv" LogicalName="EternalWars.Buildings.csv" />
    <EmbeddedResource Include="..\data\artifacts.csv" Link="Artifacts\artifacts.csv" LogicalName="EternalWars.Artifacts.csv" />
    <EmbeddedResource Include="..\data\artifact_sets.csv" Link="Artifacts\artifact_sets.csv" LogicalName="EternalWars.ArtifactSets.csv" />
    <EmbeddedResource Include="..\data\scenery.csv" Link="Objects\scenery.csv" LogicalName="EternalWars.Scenery.csv" />
    <EmbeddedResource Include="..\data\riddles.csv" Link="Objects\riddles.csv" LogicalName="EternalWars.Riddles.csv" />
    <EmbeddedResource Include="..\data\spells.csv" Link="Magic\spells.csv" LogicalName="EternalWars.Spells.csv" />
  </ItemGroup>

</Project>
