[sub_resource type="Shader" id="Shader_cwbjy"]
code = "shader_type spatial;
render_mode diffuse_lambert, specular_schlick_ggx;

// --- OUR DECOUPLED FOG MODULE PIPELINE ---
global uniform sampler2D fog_texture_mask : filter_linear, repeat_disable;
global uniform vec2 fog_map_size;
global uniform vec2 fog_world_offset;

// Terrain3D exposes its composite painted texture array through this uniform slot
uniform sampler2DArray texture_array_albedo : source_color, filter_linear_mipmap_anisotropic, repeat_enable;

varying vec3 world_vertex_pos;

void vertex() {
    // Cache the absolute world position of the ground vertices
    world_vertex_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
    // 1. Calculate a standard top-down UV map for painting the landscape textures
    // Adjust the 10.0 scaling value to make your ground textures tile larger or smaller
    vec2 terrain_uv = world_vertex_pos.xz / 10.0; 
    
    // 2. Fetch the default base texture layer from Terrain3D's texture array (Index 0)
    vec4 ground_color = texture(texture_array_albedo, vec3(terrain_uv, 0.0));
    
    // 3. Shift the world space position so center (0,0) fits on our 2D texture map pixel matrix
    vec2 adjusted_pos = world_vertex_pos.xz + fog_world_offset;
    vec2 fog_uv = adjusted_pos / fog_map_size;
    
    // 4. Sample our dynamic C# rendering viewport buffer
    float visibility_factor = texture(fog_texture_mask, fog_uv).r;
    
    // 5. Blend Terrain3D's painted textures right down into pure strategic shadow!
    ALBEDO = mix(vec3(0.0), ground_color.rgb, visibility_factor);
}"

